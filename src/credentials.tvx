# The credential chain of the AWS SDKs, in their order: the environment, the shared credentials file, the endpoint of a
# container (ECS, EKS, Lambda with SnapStart), and the instance metadata of EC2 (IMDSv2).
from sigv4 import Credentials

fn env(name: Text) -> Text:
    std.env.get(name).unwrap_or("")

fn from_environment() -> Credentials?:
    let key = env("AWS_ACCESS_KEY_ID")
    let secret = env("AWS_SECRET_ACCESS_KEY")
    if key.is_empty() or secret.is_empty():
        return None
    let token = env("AWS_SESSION_TOKEN")
    Some(Credentials(access_key: key, secret_key: secret, session_token: None if token.is_empty() else Some(token)))

# The `[profile]` section of an INI file such as `~/.aws/credentials`, as keys and values.
fn ini_section(text: Text, profile: Text) -> Map[Text, Text]:
    let out: Map[Text, Text] = std.map.new()
    var inside = False
    for raw in text.lines():
        let line = raw.trim()
        if line.starts_with("[") and line.ends_with("]"):
            inside = line.slice(1, -1).trim() == profile
        elif inside and line.contains("=") and not line.starts_with("#") and not line.starts_with(";"):
            let at = line.find("=").unwrap()
            out.insert(line.slice(0, at).trim(), line.slice(at + 1, line.chars().len()).trim())
    out

fn from_shared_file() -> Credentials?:
    var path = env("AWS_SHARED_CREDENTIALS_FILE")
    if path.is_empty():
        let home = env("HOME")
        if home.is_empty():
            return None
        path = home + "/.aws/credentials"
    let profile = "default" if env("AWS_PROFILE").is_empty() else env("AWS_PROFILE")
    match std.fs.read(path):
        case Ok(text):
            let s = ini_section(text, profile)
            match (s.get("aws_access_key_id"), s.get("aws_secret_access_key")):
                case (Some(key), Some(secret)):
                    Some(Credentials(access_key: key, secret_key: secret, session_token: s.get("aws_session_token")))
                case _:
                    None
        case Err(_):
            None

# The JSON of the container endpoint and of the instance metadata: `AccessKeyId`, `SecretAccessKey`, `Token`.
fn from_json(text: Text) -> Result[Credentials, Text]:
    let parsed: Result[Map[Text, Text], Text] = std.json.parse(text)
    let m = parsed?
    match (m.get("AccessKeyId"), m.get("SecretAccessKey")):
        case (Some(key), Some(secret)):
            Ok(Credentials(access_key: key, secret_key: secret, session_token: m.get("Token")))
        case _:
            Err("the credentials have no AccessKeyId or SecretAccessKey")

fn from_container() -> Result[Credentials?, Text]:
    var url = env("AWS_CONTAINER_CREDENTIALS_FULL_URI")
    let relative = env("AWS_CONTAINER_CREDENTIALS_RELATIVE_URI")
    if url.is_empty() and not relative.is_empty():
        url = "http://169.254.170.2" + relative
    if url.is_empty():
        return Ok(None)
    let headers: Map[Text, Text] = std.map.new()
    var token = env("AWS_CONTAINER_AUTHORIZATION_TOKEN")
    let token_file = env("AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE")
    if not token_file.is_empty():
        token = std.fs.read(token_file)?.trim()
    if not token.is_empty():
        headers.insert("authorization", token)
    let resp = std.http.client.get(url, headers)?
    if not resp.ok():
        return Err(f"the container credentials endpoint answered {resp.status()}")
    Ok(Some(from_json(resp.text()?)?))

let IMDS = "http://169.254.169.254"

fn from_instance() -> Result[Credentials?, Text]:
    if env("AWS_EC2_METADATA_DISABLED") == "true":
        return Ok(None)
    let ask: Map[Text, Text] = std.map.new()
    ask.insert("x-aws-ec2-metadata-token-ttl-seconds", "21600")
    # Not on EC2: the address does not answer, and the chain ends with no credentials.
    match std.http.client.put(IMDS + "/latest/api/token", "", ask):
        case Ok(resp):
            if not resp.ok():
                return Ok(None)
            let headers: Map[Text, Text] = std.map.new()
            headers.insert("x-aws-ec2-metadata-token", resp.text()?)
            let base = IMDS + "/latest/meta-data/iam/security-credentials/"
            let roles = std.http.client.get(base, headers)?
            if not roles.ok():
                return Ok(None)
            let role = roles.text()?.trim().lines().first().unwrap_or("")
            let creds = std.http.client.get(base + role, headers)?
            Ok(Some(from_json(creds.text()?)?))
        case Err(_):
            Ok(None)

# The first credentials of the chain, or an error that lists where they were looked for.
fn load() -> Result[Credentials, Text]:
    match from_environment():
        case Some(c):
            return Ok(c)
        case None:
            pass
    match from_shared_file():
        case Some(c):
            return Ok(c)
        case None:
            pass
    match from_container()?:
        case Some(c):
            return Ok(c)
        case None:
            pass
    match from_instance()?:
        case Some(c):
            Ok(c)
        case None:
            Err("no AWS credentials: set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, add them to ~/.aws/credentials, or run with a role (container or EC2)")

# The region: `AWS_REGION`, then `AWS_DEFAULT_REGION`.
fn region() -> Result[Text, Text]:
    for name in ["AWS_REGION", "AWS_DEFAULT_REGION"]:
        if not env(name).is_empty():
            return Ok(env(name))
    Err("no AWS region: set AWS_REGION")
