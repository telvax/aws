# The examples that AWS publishes, with their signatures.
from sigv4 import Credentials, Request, signature, uri_encode

let EMPTY = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

fn no_entries() -> Map[Text, Text]:
    std.map.new()

# `get-vanilla` of the AWS Signature Version 4 test suite.
fn test_get_vanilla():
    let creds = Credentials(access_key: "AKIDEXAMPLE", secret_key: "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY", session_token: None)
    let req = Request(method: "GET", host: "example.amazonaws.com", path: "/", query: no_entries(), headers: no_entries(), payload_hash: EMPTY)
    let (auth, _) = signature(req, creds, "us-east-1", "service", "20150830T123600Z", True)
    assert_eq(auth, "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/service/aws4_request, SignedHeaders=host;x-amz-date, Signature=5fa00fa31553b73ebf1942676e86291e8372ff2a2260956d9b8aae1d763fbf31")

# The GET with a range of the S3 documentation ("Example: GET Object").
fn test_s3_get_object():
    let creds = Credentials(access_key: "AKIAIOSFODNN7EXAMPLE", secret_key: "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY", session_token: None)
    let headers = no_entries()
    headers.insert("Range", "bytes=0-9")
    headers.insert("x-amz-content-sha256", EMPTY)
    let req = Request(method: "GET", host: "examplebucket.s3.amazonaws.com", path: "/test.txt", query: no_entries(), headers: headers, payload_hash: EMPTY)
    let (auth, _) = signature(req, creds, "us-east-1", "s3", "20130524T000000Z", False)
    assert_eq(auth, "AWS4-HMAC-SHA256 Credential=AKIAIOSFODNN7EXAMPLE/20130524/us-east-1/s3/aws4_request, SignedHeaders=host;range;x-amz-content-sha256;x-amz-date, Signature=f0e8bdb87c964420e857bd35b5d6ed310bd44f0170aba48dd91039c6036bdb41")

fn test_uri_encoding():
    assert_eq(uri_encode("a b/ç~*", True), "a%20b/%C3%A7~%2A")
    assert_eq(uri_encode("a/b", False), "a%2Fb")
