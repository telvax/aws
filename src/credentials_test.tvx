from credentials import ini_section, from_json

fn test_a_profile_of_the_shared_file():
    let text = "[default]\naws_access_key_id = AKIDDEFAULT\n\n[work]\n# a comment\naws_access_key_id=AKIDWORK\naws_secret_access_key = s3cr=t\n"
    let work = ini_section(text, "work")
    assert_eq(work.get("aws_access_key_id"), Some("AKIDWORK"))
    assert_eq(work.get("aws_secret_access_key"), Some("s3cr=t"))
    assert_eq(ini_section(text, "default").len(), 1)
    assert(ini_section(text, "other").is_empty())

fn test_the_json_of_a_role():
    let c = from_json("{\"AccessKeyId\": \"ASIA1\", \"SecretAccessKey\": \"sk\", \"Token\": \"tok\", \"Expiration\": \"2026-11-26T05:00:00Z\"}").unwrap()
    assert_eq(c.access_key, "ASIA1")
    assert_eq(c.session_token, Some("tok"))
    assert(from_json("{\"Code\": \"Failure\"}").is_err())
